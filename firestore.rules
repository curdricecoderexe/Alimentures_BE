rules_version = '2';
// The storefront never talks to Firestore directly: every read/write goes
// through the API with the Admin SDK (which bypasses these rules). So no
// client SDK access is allowed at all.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
