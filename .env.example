# ── Core ──────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development            # "production" on the server (PM2 sets it via deploy/ecosystem.config.js)

# Comma-separated list of allowed browser origins (no trailing slash).
# REQUIRED in production (the server exits on boot if unset when NODE_ENV=production).
# In dev it falls back to localhost + the Netlify URL.
CORS_ORIGIN=http://localhost:5173            # production: https://alimenture.in

# ── Firebase Admin (server-side; NEVER commit the real value) ─────────────────
# Full service-account JSON as a single-line string. REQUIRED.
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"your_project","private_key":"your_private_key"}'

# Firebase Web API key — used server-side to sign users in via the Identity
# Toolkit REST API. REQUIRED. Restrict it (HTTP referrer + API) in Google Cloud.
FIREBASE_WEB_API_KEY=your_firebase_web_api_key

# ── Razorpay (use TEST keys locally) ────────────────────────────────────────── (all REQUIRED)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── Shiprocket (delivery partner) — OPTIONAL ────────────────────────────────
# Create a dedicated API user: Shiprocket panel → Settings → API → Configure.
# (Use the API user's email/password, NOT your main Shiprocket login.)
# Without these four, Shiprocket is disabled and orders are fulfilled manually.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Pickup address nickname exactly as saved in Shiprocket → Settings → Pickup Addresses.
SHIPROCKET_PICKUP_LOCATION=Primary
# PIN code of that pickup address (used for courier serviceability checks).
SHIPROCKET_PICKUP_PINCODE=600001
# Token Shiprocket sends in the x-api-key header of tracking webhooks.
# Configure in Shiprocket → Settings → API → Webhooks with the URL
#   https://<your-api-host>/api/shipping/webhook
# (Shiprocket rejects webhook URLs containing "shiprocket", "kartrocket", "sr" or "kr".)
SHIPROCKET_WEBHOOK_TOKEN=change_me_to_a_long_random_string
# Push paid orders to Shiprocket automatically (default true). Set false to push manually from Admin → Orders.
SHIPROCKET_AUTO_CREATE=true
# Default parcel size (cm) and per-item weight (kg) when a variant weight like "500g" can't be parsed.
SHIPROCKET_PKG_LENGTH_CM=20
SHIPROCKET_PKG_BREADTH_CM=15
SHIPROCKET_PKG_HEIGHT_CM=10
SHIPROCKET_DEFAULT_ITEM_WEIGHT_KG=0.5

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_SECURE=false              # true only for port 465
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password

# ── OTP ──────────────────────────────────────────────────────────────────────
# Long random string mixed into OTP hashes. REQUIRED in production.
OTP_PEPPER=change_me_to_a_long_random_string

# ── Scheduled jobs ───────────────────────────────────────────────────────────
# Shared secret the reservation-cleanup cron presents in the X-Cron-Secret header.
# REQUIRED in production.
RESERVATION_CLEANUP_SECRET=change_me_to_a_long_random_string

# ── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=info                # debug | info | warn | error
# Slack / Discord / Better Stack incoming webhook. Every log.error() (server
# errors + forwarded client errors) is POSTed here. REQUIRED for production
# error visibility (not enforced at boot, but the deploy checklist gates on it).
ERROR_WEBHOOK_URL=

# ── Optional tuning ──────────────────────────────────────────────────────────
GLOBAL_RATE_MAX=1000            # requests / 15 min / IP across all /api
ANALYTICS_DAILY_MAX=2000        # analytics ingest writes / day / IP
ANALYTICS_RETENTION_DAYS=90     # raw analytics doc retention (retention cron)
DOMAIN=https://alimenture.in    # used in transactional email links

# Proxy hops in front of the API so rate limits key on the real client IP.
# 1 = Render / a single nginx (default), 2 = Cloudflare -> nginx. Never set higher than reality.
# TRUST_PROXY_HOPS=1

# Optional: signs catalogue download links (defaults to a key derived from the service account)
CATALOGUE_TOKEN_SECRET=

# ── Storefront rebuilds (SEO) ────────────────────────────────────────────────
# Product/category changes trigger a (debounced) storefront rebuild so the
# pre-rendered pages, sitemap and redirects stay current. Set ONE of:
#   VPS (same server): the rebuild script
SITE_REBUILD_COMMAND="bash /var/www/alimenture/frontend/repo/deploy/rebuild-frontend.sh"
#   Netlify: Site configuration → Build & deploy → Build hooks
NETLIFY_BUILD_HOOK_URL=
# SITE_REBUILD_DEBOUNCE_MS=180000

# ── Newsletter ───────────────────────────────────────────────────────────────
# Public origin of this API (no /api). Used for product image URLs, unsubscribe
# links and SEO. REQUIRED in production so URLs never point at 127.0.0.1.
API_PUBLIC_URL=https://alimenture.in
# Optional: signs unsubscribe links (defaults to a key derived from the service account)
NEWSLETTER_TOKEN_SECRET=

# ── Scheduled jobs ───────────────────────────────────────────────────────────
# The API releases stock held by abandoned checkouts every 5 minutes in-process.
# Set false only if an external scheduler calls POST /api/orders/cleanup-reservations.
# INTERNAL_CRON=true
# RESERVATION_CLEANUP_INTERVAL_MS=300000
