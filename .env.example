# ── Core ──────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development            # set to "production" on Render

# Comma-separated list of allowed browser origins (no trailing slash).
# REQUIRED in production (the server exits on boot if unset when NODE_ENV=production).
# In dev it falls back to localhost + the Netlify URL.
CORS_ORIGIN=http://localhost:5173,https://alimenture.netlify.app

# ── Firebase Admin (server-side; NEVER commit the real value) ─────────────────
# Full service-account JSON as a single-line string. REQUIRED.
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"your_project","private_key":"your_private_key"}'

# Firebase Web API key — used server-side to sign users in via the Identity
# Toolkit REST API. REQUIRED. Restrict it (HTTP referrer + API) in Google Cloud.
FIREBASE_WEB_API_KEY=your_firebase_web_api_key

# ── Razorpay (use TEST keys locally) ────────────────────────────────────────── (all REQUIRED)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_SECURE=false              # true only for port 465
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password

# ── OTP ──────────────────────────────────────────────────────────────────────
# Long random string mixed into OTP hashes. REQUIRED in production.
OTP_PEPPER=change_me_to_a_long_random_string

# ── Scheduled jobs ───────────────────────────────────────────────────────────
# Shared secret the reservation-cleanup cron presents in the X-Cron-Secret header.
# REQUIRED in production.
RESERVATION_CLEANUP_SECRET=change_me_to_a_long_random_string

# ── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=info                # debug | info | warn | error
# Slack / Discord / Better Stack incoming webhook. Every log.error() (server
# errors + forwarded client errors) is POSTed here. REQUIRED for production
# error visibility (not enforced at boot, but the deploy checklist gates on it).
ERROR_WEBHOOK_URL=

# ── Optional tuning ──────────────────────────────────────────────────────────
GLOBAL_RATE_MAX=1000            # requests / 15 min / IP across all /api
ANALYTICS_DAILY_MAX=2000        # analytics ingest writes / day / IP
ANALYTICS_RETENTION_DAYS=90     # raw analytics doc retention (retention cron)
DOMAIN=https://alimenture.in    # used in transactional email links
